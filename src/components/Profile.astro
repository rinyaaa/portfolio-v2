---
import styles from "./Profile.module.scss";
import { PROFILE_ITEMS, PROFILE_NAME } from "../data/profile";

const info = PROFILE_ITEMS;
---

<section class={styles.section}>
  <h2 class="section-title">My Profile</h2>

  <div class={styles.card}>
    <div class={styles.imageWrap}>
      <img
        src="/avatar.svg"
        alt="nenex のイラスト"
        width="260"
        height="260"
      />
    </div>

    <div class={styles.body}>
      <h3 class={styles.name}>{PROFILE_NAME}</h3>
      <dl class={styles.info}>
        {
          info.map((item) => (
            <>
              <dt class={styles.label}>{item.label}</dt>
              <dd class={styles.value}>{item.value}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </div>
</section>
