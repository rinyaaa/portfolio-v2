---
import Base from "../layouts/Base.astro";
import Profile from "../components/Profile.astro";
import HeartRate from "../components/HeartRate";
import SkillSection from "../components/SkillSection.astro";
import NewPostPreview from "../components/NewPostPreview.astro";
import Awards from "../components/Awards.astro";
import BirthdayCountdown from "../components/BirthdayCountdown.astro";
import ConnectLinks from "../components/ConnectLinks.astro";
import RinyaAiChat from "../components/RinyaAiChat";
---

<Base
  title="nenex — Portfolio"
  description="石丸凜弥（りんや / いしまる / nenex / ねねっくす）のポートフォリオ。愛知工業大学 シス研・梶研究室 / NxTEND / FORGERS所属、Webフルスタック開発をしています。"
>
  <Profile />
  <HeartRate client:visible />
  <SkillSection />
  <NewPostPreview />
  <Awards />
  <BirthdayCountdown />
  <ConnectLinks />
  {/* client:visible は使えない：中身が position:fixed のため astro-island 自体が高さ0で
      ドキュメント最下部に置かれ、最下部までスクロールするまで hydration されない
      （ボタンは fixed で最初から見えているので「押せるのに無反応」になる）。
      初回表示をブロックしない client:idle にする。 */}
  <RinyaAiChat client:idle />
</Base>
