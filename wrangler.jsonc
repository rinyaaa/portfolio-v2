{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-05",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "portfolio-v2",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// rinyaAI の回答生成。APIキー不要（バインディング経由で env.AI として使える）。
	// Workers Free プランでは無料枠 10,000 Neurons/日 を超えると課金ではなくエラーになるため、
	// 費用の上限はプラン側で自動的に閉じている（超過時は固定Q&Aへフォールバックする）。
	// Astro のセッション用 KV。`@astrojs/cloudflare` がこのバインディングを自動で有効化するが、
	// id を書かないと `wrangler deploy` が KV namespace の**新規作成**を試みる。
	// 既に `portfolio-v2-session` が存在するため、Workers Builds（毎回クローンし直すCI）では
	// `a namespace with this account ID and title already exists [code: 10014]` でデプロイが失敗した
	// （ローカルの `npm run deploy` は `.wrangler/` のローカル状態で既存を参照できていたので露出しなかった）。
	// 既存の id を明示すると、アダプタもこちらの設定を優先して作成を試みなくなる。
	// namespace id は秘密情報ではない（アカウント資格情報が無ければ使えない単なる識別子）。
	// なお Astro のセッション機能自体はコード上未使用（`Astro.session` の参照なし）。
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "93d317be2acc4ad4b395f0290dada3ca"
		}
	],
	// Workers AI は常にリモート（実物のCloudflare）を呼ぶバインディングなので、
	// ビルド/開発時に接続を張らせないための切り替えは astro.config.mjs の
	// `remoteBindings` 側で行う（ここに `remote: false` を書いても接続は止まらない）。
	"ai": {
		"binding": "AI"
	},
	// 1つのIPが無料枠を使い切らないようにするための入口制限（period は 10 か 60 のみ指定可）。
	// 費用の上限自体は Workers Free プランの無料枠が握っている（超過は課金ではなくエラー）ので、
	// ここは「1人が独占しないための公平性」の設定。超過時は 429 を返し、UIで待つよう案内する。
	"ratelimits": [
		{
			"name": "RINYA_AI_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	}
}